# Backend (Node / Hono)
# Copie ce fichier en `backend/.env` sur ta machine et/ou sur le VPS.
#
# ⚠️ Ne pas committer `backend/.env` ni `backend/firebase-adminsdk.json`.

# Runtime
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Sécurité / session (OBLIGATOIRES : le serveur refuse de démarrer sans ça)
SESSION_SECRET=
SECURE_PASSWORD=

# CORS (prod)
# Exemple : https://www.example.com,https://example.com
CORS_ORIGINS=

# URL du site (utilisée dans certains emails / liens)
SITE_URL=

# Firebase Admin (serveur)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Firebase client config (si l'API doit la renvoyer au front)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=

# Email (SMTP)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_INTERNAL_TO=
SMTP_CONCURRENCY=5

# reCAPTCHA (vérification côté serveur)
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# OpenAI (fonctionnalités planner/chat)
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-5-mini

# Optionnels
LIKES_IP_SALT=
INVITE_EXPIRES_DAYS=30
ADMIN_DASHBOARD_REFRESH_COOLDOWN_MS=15000
EMAIL_LOCK_TTL_MS=900000
