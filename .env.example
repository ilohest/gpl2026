# Frontend (Vite)
# Copie ce fichier en `.env` si tu veux personnaliser la config.
#
# Note : ce projet a des valeurs par défaut (voir `shared/weddingConfig.ts`),
# donc ce fichier est optionnel.

VITE_BRIDE_FIRST_NAME=
VITE_BRIDE_LAST_NAME=
VITE_GROOM_FIRST_NAME=
VITE_GROOM_LAST_NAME=

# Optionnel : si tu veux injecter la config Firebase côté front (sinon elle peut
# être fournie via l'API).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
