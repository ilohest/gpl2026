{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "hono": ["backend/node_modules/hono/dist/types/index"],
      "hono/*": ["backend/node_modules/hono/dist/types/*"]
    },
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "shared/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "backend"]
}
