{
  "name": "liana-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:front\" \"npm:dev:server\"",
    "dev:front": "vite",
    "dev:server": "NODE_ENV=development PORT=3001 HOST=127.0.0.1 tsx watch backend/server.ts",
    "lint": "eslint src backend --ext .ts,.vue",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p backend/tsconfig.json",
    "build": "vite build",
    "deploy:vps": "./scripts/deploy-vps.sh",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "npm --prefix backend test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@primevue/themes": "^4.3.7",
    "@vueuse/core": "^13.7.0",
    "chart.js": "^4.5.1",
    "dotenv": "^17.2.3",
    "firebase": "^12.1.0",
    "html2pdf.js": "^0.12.1",
    "multer": "^2.0.2",
    "pinia": "^3.0.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.7",
    "quill": "^2.0.3",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.18",
    "vue-easy-lightbox": "^1.19.0",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1",
    "vuedraggable": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.4.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.6.2",
    "firebase-tools": "^15.16.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.55.0",
    "unplugin-auto-import": "^20.0.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.1.2",
    "vue-tsc": "^2.2.12"
  }
}
